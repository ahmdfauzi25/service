ENV=local
API_URL=svc/
PORT=3010
VERSION=v1
KEY_ENC=YourEncryptionKeyHere32Characters
SECRET_KEY=YourSecretKeyForJWTToken

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=service_db
DB_USERNAME=postgres
DB_PASSWORD=password
CONNECTIONLIMIT=10

# Request Timeout
ACQRTETIMEOUT=30000

# Logging
LOG_LEVEL=info
